\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Top 10 predictor groups after hierarchical correlation clustering (Spearman $|r| > 0.70$). Correlated features are merged into a single cluster and their importances are summed to correct for the collinear dilution effect. Red bars indicate multi-feature clusters; blue bars are stand-alone predictors.}}{24}{figure.caption.19}\protected@file@percent }
\newlabel{fig:feature_importance_clustered}{{9}{24}{Top 10 predictor groups after hierarchical correlation clustering (Spearman $|r| > 0.70$). Correlated features are merged into a single cluster and their importances are summed to correct for the collinear dilution effect. Red bars indicate multi-feature clusters; blue bars are stand-alone predictors}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces SHAP beeswarm plot for the opposition model at the filing baseline. Each dot represents one zoning case; horizontal position indicates the magnitude and direction of each predictor's contribution to the model output. SHAP values use tree path-dependent conditional expectations, which handle correlated features more reliably than standard permutation importance. However, standard SHAP values can still shift credit between highly correlated predictors across different background samples; full pairwise interaction decomposition would require SHAP interaction values at substantially higher computational cost. The clustered importance in Figure~\ref {fig:feature_importance_clustered} provides the most robust correction for collinearity.}}{25}{figure.caption.20}\protected@file@percent }
\newlabel{fig:shap_beeswarm}{{10}{25}{SHAP beeswarm plot for the opposition model at the filing baseline. Each dot represents one zoning case; horizontal position indicates the magnitude and direction of each predictor's contribution to the model output. SHAP values use tree path-dependent conditional expectations, which handle correlated features more reliably than standard permutation importance. However, standard SHAP values can still shift credit between highly correlated predictors across different background samples; full pairwise interaction decomposition would require SHAP interaction values at substantially higher computational cost. The clustered importance in Figure~\ref {fig:feature_importance_clustered} provides the most robust correction for collinearity}{figure.caption.20}{}}
